# --- Clé API : À REMPLACER par ta vraie clé dans le .env (jamais ici) ---
LLM_API_KEY=sk-remplace-moi-par-ta-vraie-cle
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=inclusionai/ling-3.0-flash-sante:free

# --- Cible à explorer (le bac à sable MiniHub) ---
TARGET_BASE_URL=http://127.0.0.1:5000

# --- Logs ---
RED_AGENT_LOG_PATH=./logs/red_agent_decisions.log