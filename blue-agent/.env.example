# ============================================================
# EXEMPLE de configuration Blue Team.
# Copie ce fichier en .env puis remplis tes vraies valeurs :
#     cp .env.example .env
# Le vrai .env NE DOIT JAMAIS être commité (il est déjà dans .gitignore).
# ============================================================

# Backend LLM : "opencode" (open router avec le modèle inclusionAI: Ling 3.0 Flash Sante (free))
LLM_BACKEND=opencode

# --- Clé API : À REMPLACER par ta vraie clé dans le .env (jamais ici) ---
OPENCODE_API_KEY=sk-remplace-moi-par-ta-vraie-cle
OPENCODE_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENCODE_MODEL=inclusionai/ling-3.0-flash-sante:free

# Chemins vers les logs à surveiller (relatifs à ce dossier)
TARGET_ACCESS_LOG=../target-env/app/logs/access.log
RED_AGENT_LOG=../red-agent/logs/red_agent_decisions.log

# Fréquence de scrutation des logs (secondes)
BLUE_POLL_INTERVAL=2

# Fichiers de sortie du Blue Team
BLUE_ALERTS_LOG_PATH=./logs/blue_agent_alerts.log
BLUE_RESPONSE_LOG_PATH=./logs/blue_agent_responses.log

# true = défenseur "aveugle" réaliste (ne lit QUE access.log, pas le
# raisonnement de l'attaquant). Mets false uniquement pour la démo
# pédagogique de corrélation attaquant/défenseur.
BLUE_BLIND_MODE=true